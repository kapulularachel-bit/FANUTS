<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/bg_card"
    app:strokeWidth="1dp"
    app:strokeColor="@color/divider_subtle">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/tvTipCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/community_filter_nutrition"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:textColor="@color/primary_green"
                android:background="@color/primary_light"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/community_tip_source"
                android:textSize="10sp"
                android:textColor="@color/text_secondary"
                android:fontStyle="italic" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTipEnglish"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="English tip goes here"
            android:textColor="@color/text_main"
            android:textSize="15sp"
            android:textStyle="bold"
            android:lineHeight="21sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvTipChichewa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chichewa tip goes here"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:lineHeight="20sp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
