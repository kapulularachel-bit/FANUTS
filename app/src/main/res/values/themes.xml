<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.FanutSystem" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Follow system light/dark; surfaces resolve via values / values-night colors -->
        <item name="colorPrimary">@color/primary_green</item>
        <item name="colorPrimaryVariant">@color/primary_green_dark</item>
        <item name="colorSecondary">@color/accent_blue</item>
        <item name="colorSecondaryVariant">@color/accent_orange</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnSurface">@color/text_main</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorSurfaceVariant">@color/stroke_light</item>
        <item name="colorError">@color/status_danger</item>

        <!-- Typography (respects user font size — important for all ages) -->
        <item name="android:textColorPrimary">@color/text_main</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        
        <!-- Material 3 Components -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.App.MaterialAlertDialog</item>
    </style>

    <style name="Theme.FanutSystem" parent="Base.Theme.FanutSystem" />

    <!-- Toolbar overlays: tint action icons (notifications) via ?attr/colorControlNormal -->
    <style name="ThemeOverlay.Fanut.Toolbar.Home" parent="ThemeOverlay.Material3.ActionBar">
        <item name="colorControlNormal">@color/text_main</item>
    </style>
    <style name="ThemeOverlay.Fanut.Toolbar.Primary" parent="ThemeOverlay.Material3.Dark.ActionBar">
        <item name="colorControlNormal">@color/white</item>
    </style>

    <style name="ThemeOverlay.Fanut.Toolbar.Emergency" parent="ThemeOverlay.Material3.Dark.ActionBar">
        <item name="colorControlNormal">@color/white</item>
    </style>

    <!-- Gender Chip Style -->
    <style name="Theme.FanutSystem.GenderChip" parent="Theme.Material3.DayNight">
        <item name="android:textColor">@color/text_main</item>
        <item name="cornerRadius">12dp</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="strokeColor">@color/stroke_light</item>
        <item name="rippleColor">@color/primary_green_light</item>
    </style>

    <!-- Text Input Style -->
    <style name="Theme.FanutSystem.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/text_input_stroke</item>
        <item name="boxStrokeWidth">1.5dp</item>
    </style>

    <!-- Material Alert Dialog Theme -->
    <style name="ThemeOverlay.App.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="buttonBarPositiveButtonStyle">@style/Widget.App.Button.TextButton.Dialog</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.App.Button.TextButton.Dialog</item>
    </style>

    <!-- Dialog Button Style -->
    <style name="Widget.App.Button.TextButton.Dialog" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/primary_green</item>
    </style>

</resources>
